{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",

	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},

	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!dist",
			"!build",
			"!coverage",
			"!node_modules",
			"!public/favicon.svg",
			"!public/icons.svg"
		]
	},

	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"lineWidth": 100,
		"attributePosition": "auto",
		"bracketSpacing": true
	},

	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",

			"correctness": {
				"useExhaustiveDependencies": "warn"
			},

			"a11y": {
				"useAltText": "error"
			}
		}
	},

	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always"
		},
		"globals": ["window", "document", "navigator", "fetch"]
	},

	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
